{
  "manifest_version": 3,
  "name": "SESİGÖR",
  "short_name": "SESİGÖR",
  "version": "1.0.0",
  "description": "Türkçe videolarda konuşma altyazısına ses olayı etiketleri ekler. Ses cihaz üzerinde işlenir; hiçbir sunucuya gönderilmez.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "SESİGÖR yan panelini aç",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "sidePanel",
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}